{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smetchik:corrections:v1",
  "title": "Smetchik correction request v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_sha256",
    "corrections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "smetchik.corrections.v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/correction"
      }
    }
  },
  "$defs": {
    "scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "cell": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]{0,6}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "oneOf": [
        {
          "properties": {
            "sheet": {},
            "cell": {}
          },
          "required": [
            "sheet",
            "cell"
          ],
          "not": {
            "properties": {
              "locator": {}
            },
            "required": [
              "locator"
            ]
          }
        },
        {
          "properties": {
            "locator": {}
          },
          "required": [
            "locator"
          ],
          "not": {
            "anyOf": [
              {
                "properties": {
                  "sheet": {}
                },
                "required": [
                  "sheet"
                ]
              },
              {
                "properties": {
                  "cell": {}
                },
                "required": [
                  "cell"
                ]
              }
            ]
          }
        }
      ]
    },
    "correction": {
      "type": "object",
      "required": [
        "id",
        "status",
        "target",
        "expected_old",
        "replacement",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "status": {
          "enum": [
            "confirmed",
            "disputed"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expected_old": {
          "$ref": "#/$defs/scalar"
        },
        "replacement": {
          "$ref": "#/$defs/scalar"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
